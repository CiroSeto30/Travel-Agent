# Copy this file to .env and fill in the real values. Never commit .env.

# PostgreSQL (used by docker-compose and by the backend)
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel
TEST_DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel_test

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333

# LLM provider: "anthropic" or "openai" or "google_genai"
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite 
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=

# Authentication: generate with
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=